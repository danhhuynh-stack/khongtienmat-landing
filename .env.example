# ==============================================================================
# KHONGTIENMAT.VN - ENVIRONMENT CONFIGURATION TEMPLATE
# DO NOT COMMIT REAL SECRETS OR .env FILE TO GIT
# ==============================================================================

# 1. Google Sheets Integration
# Cách A: Dùng Google Apps Script Web App (Khuyên dùng - Đơn giản, an toàn cho doanh nghiệp)
GOOGLE_APPS_SCRIPT_URL="https://script.google.com/macros/s/AKfycb.../exec"

# Cách B: Dùng Google Service Account (Nếu tổ chức không chặn key creation)
GOOGLE_SERVICE_ACCOUNT_EMAIL="your-service-account@your-gcp-project.iam.gserviceaccount.com"
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEET_ID="your_google_sheet_id_here"

# Tab name inside Google Sheets (Default: Leads)
GOOGLE_SHEET_TAB="Leads"

# 2. Telegram Bot Integration (Khuyên dùng - Nhận thông báo ting ting ngay về điện thoại)
# Token lấy từ @BotFather trên Telegram
TELEGRAM_BOT_TOKEN="1234567890:ABCdefGhIJKlmNoPQRsTUVwxyZ_Example"

# Chat ID lấy từ @userinfobot trên Telegram (hoặc ID nhóm chat)
TELEGRAM_CHAT_ID="123456789"

# 3. Zalo Chatbot Webhook Integration (Tùy chọn - Dành cho Zalo OA doanh nghiệp)
# The official webhook URL provided by your Zalo Chatbot platform (e.g. FPT.AI, Hana99, Haravan, Botbanhang, Zalo OA webhook)
ZALO_CHATBOT_WEBHOOK_URL="https://your-chatbot-platform.com/api/v1/lead-webhook"

# Optional Bearer Token or secret required by the chatbot endpoint
ZALO_CHATBOT_API_TOKEN="optional_secret_api_token"

# 4. Security & CORS
# Comma-separated list of allowed origins
ALLOWED_ORIGINS="https://danhhuynh-stack.github.io,https://khongtienmat.vn,https://www.khongtienmat.vn,http://localhost:3000,http://127.0.0.1:3000"
